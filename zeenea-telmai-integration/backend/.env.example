# Zeenea Data Catalog
# URL format: https://{tenant}.zeenea.app/api/catalog/graphql
# Auth: sent as X-API-SECRET header (NOT X-API-Key or Authorization: Bearer)
ZEENEA_URL=https://your-tenant.zeenea.app/api/catalog/graphql
ZEENEA_API_KEY=your_zeenea_api_key

# Telmai Data Quality
# endpoint: base URL of your Telmai deployment (e.g. https://app.telm.ai)
# auth_endpoint: auth server URL — usually the same as endpoint (leave blank to use endpoint)
TELMAI_ENDPOINT=https://app.telm.ai
TELMAI_TENANT=your_tenant_name
# Option A: static Bearer token (Okta/SSO deployments like Actian)
# Obtain from your Telmai browser session or Profile → API Token
TELMAI_API_TOKEN=
# Option B: username/password (standard Telmai deployments)
TELMAI_USERNAME=your_telmai_username
TELMAI_PASSWORD=your_telmai_password
TELMAI_CLIENT_ID=telmai
TELMAI_AUTH_ENDPOINT=

# Integration service API key (protects this backend's own endpoints)
INTEGRATION_API_KEY=your_integration_api_key_here

# Telmai webhook secret — used to verify HMAC-SHA256 signatures on incoming webhooks.
# Set this in Telmai's webhook config and copy the same value here.
# Leave blank to disable signature verification (dev/test only).
TELMAI_WEBHOOK_SECRET=
