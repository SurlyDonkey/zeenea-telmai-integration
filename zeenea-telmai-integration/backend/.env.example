# Zeenea Data Catalog
ZEENEA_URL=https://your-tenant.zeenea.app/api/graphql
ZEENEA_API_KEY=your_zeenea_api_key

# Telmai Data Quality
# endpoint: base URL of your Telmai deployment (e.g. https://app.telm.ai)
# auth_endpoint: auth server URL — usually the same as endpoint (leave blank to use endpoint)
TELMAI_ENDPOINT=https://app.telm.ai
TELMAI_TENANT=your_tenant_name
TELMAI_USERNAME=your_telmai_username
TELMAI_PASSWORD=your_telmai_password
TELMAI_CLIENT_ID=telmai
TELMAI_AUTH_ENDPOINT=

# Integration service API key (protects this backend's own endpoints)
INTEGRATION_API_KEY=your_integration_api_key_here
